# ==========================================
# VELO - MongoDB Atlas Configuration
# ==========================================

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and database name with your Atlas credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yahvere.mongodb.net/velo-blog?retryWrites=true&w=majority
# (DB_URL and DATABASE_URL are also supported fallbacks)
DB_URL=mongodb+srv://<username>:<password>@cluster0.yahvere.mongodb.net/velo-blog?retryWrites=true&w=majority

# Better Auth Secret (Generate a strong 32+ character random string)
BETTER_AUTH_SECRET=your-random-secret-key-at-least-32-chars-long
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Production (Vercel): You can set any of these (with or without https://):
# BETTER_AUTH_URL=https://velo-blogs1.vercel.app
# NEXT_PUBLIC_URL=https://velo-blogs1.vercel.app

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (Optional for Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=

# Upstash Redis (Optional for caching layer)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
